project text-animation {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item navy {
        source generated solid { color #101827ff; }
        record { at 0s; duration 12s; }
      }
    }
    layer visual animation-showcase {
      item whole {
        source text {
          content "整段动画\n淡入、滑入与缩放";
          style {
            font family "Arial Unicode MS";
            fallback-font family "Arial";
            size 52px;
            weight bold;
            fill #f7f7f2ff;
          }
          animation {
            unit whole;
            stagger 0ms;
            opacity curve {
              key transparent { at 0s; value 0%; interpolation linear; }
              key opaque { at 700ms; value 100%; interpolation hold; }
            }
            transform {
              position curve {
                key left { at 700ms; value { x -120px; y 0px; } interpolation ease-out; }
                key centered { at 1.5s; value { x 0px; y 0px; } interpolation hold; }
              }
              scale curve {
                key small { at 1.5s; value { x 75%; y 75%; } interpolation ease-out; }
                key full { at 2.4s; value { x 100%; y 100%; } interpolation hold; }
              }
            }
          }
        }
        record { at 0s; duration 3s; }
      }
      item highlight {
        source text {
          content "高亮 进度\n逐词 向前 推进";
          style {
            font family "Arial Unicode MS";
            fallback-font family "Arial";
            size 52px;
            weight bold;
            fill #f7f7f2ff;
          }
          animation {
            unit word;
            stagger 0ms;
            highlight {
              fill #ffd166ff;
              progress curve {
                key plain { at 0s; value 0%; interpolation linear; }
                key colored { at 1.6s; value 100%; interpolation hold; }
              }
            }
          }
        }
        record { at 3s; duration 2s; }
      }
      item line {
        source text {
          content "按行依次揭示\n第二行随后出现";
          style { font family "Arial Unicode MS"; size 50px; weight bold; fill #2dd4bfff; }
          animation {
            unit line;
            stagger 400ms;
            opacity curve {
              key line-transparent { at 0s; value 0%; interpolation linear; }
              key line-opaque { at 200ms; value 100%; interpolation hold; }
            }
          }
        }
        record { at 5s; duration 2s; }
      }
      item word {
        source text {
          content "按 词语 依次 揭示";
          style { font family "Arial Unicode MS"; size 50px; weight bold; fill #ff8a5bff; }
          animation {
            unit word;
            stagger 300ms;
            opacity curve {
              key word-transparent { at 0s; value 0%; interpolation linear; }
              key word-opaque { at 150ms; value 100%; interpolation hold; }
            }
          }
        }
        record { at 7s; duration 2s; }
      }
      item grapheme {
        source text {
          content "字素依次出现";
          style { font family "Arial Unicode MS"; size 50px; weight bold; fill #f7f7f2ff; }
          animation {
            unit grapheme;
            stagger 0ms;
            reveal curve {
              key grapheme-hidden { at 0s; value 0%; interpolation linear; }
              key grapheme-shown { at 1.5s; value 100%; interpolation hold; }
            }
          }
        }
        record { at 9s; duration 3s; }
      }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
