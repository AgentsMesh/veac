import "./animations.veac" as animations;
import "./showcase.veac" as showcase;

fn animated(
  key: identifier, content: text, start: time,
  granularity: TextGranularity, progressive: bool, font: Resource
) -> Item {
  item(
    key, item_enabled(), during(start, 1500ms),
    source_text(content, animations.style(font, granularity, progressive)),
    source_timing_native()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let background = visual_layer(
    identifier("background"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("plate"), #312e81ff, 0s, 6s));
  let copy = visual_layer(
    identifier("copy"), 1, placement_free(),
    showcase.state(), track_routing_default()
  )
    .with_item(animated(identifier("whole"), "整块动画", 0s, text_whole(), false, font))
    .with_item(animated(
      identifier("line"), "第一行动画\n第二行动画", 1500ms, text_line(), true, font
    ))
    .with_item(animated(
      identifier("word"), "逐词 动画 类型化 关键帧", 3s, text_word(), true, font
    ))
    .with_item(animated(
      identifier("grapheme"), "逐字动画：打字机揭示", 4500ms,
      text_grapheme(), true, font
    ));
  let timeline = sequence(
    identifier("main"), "文本动画原语",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(background).with_layer(copy);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  project(identifier("text-animation"), project_settings(600))
    .with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
