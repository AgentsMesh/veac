module {
  fn motion() -> TextUnitTransform {
    text_unit_transform(
      point_keyframes([
        point_keyframe(identifier("position-start"), 0s, point(0px, 28px), interpolation_ease_out()),
        point_keyframe(identifier("position-end"), 1s, point(0px, 0px), interpolation_linear())
      ]),
      vector_keyframes([
        vector_keyframe(identifier("scale-start"), 0s, vector(0.75, 0.75), interpolation_ease_in()),
        vector_keyframe(identifier("scale-end"), 1s, vector(1.0, 1.0), interpolation_ease_out())
      ]),
      angle_constant(0deg)
    )
  }

  fn progress() -> PercentAnimation {
    percent_keyframes([
      percent_keyframe(identifier("start"), 0s, 0%, interpolation_hold()),
      percent_keyframe(identifier("middle"), 500ms, 55%, interpolation_ease_in_out()),
      percent_keyframe(identifier("end"), 1s, 100%, interpolation_linear())
    ])
  }

  fn animation(granularity: TextGranularity, progressive: bool) -> TextAnimationChoice {
    let reveal = if progressive { progress() } else { percent_constant(100%) };
    text_animation_present(text_animation(
      granularity, motion(), reveal,
      text_highlight_present(#facc15ff, reveal),
      percent_keyframes([
        percent_keyframe(identifier("opacity-start"), 0s, 0%, interpolation_linear()),
        percent_keyframe(identifier("opacity-end"), 400ms, 100%, interpolation_ease_out())
      ]),
      45ms
    ))
  }

  export fn style(
    font: Resource, granularity: TextGranularity, progressive: bool
  ) -> TextStyle {
    text_style(
      text_metrics(
        font_stack(font_resource_ref(font), []),
        weight_bold(), font_style_normal(), 46px, 1px, 1.2, #ffffffff
      ),
      text_layout(
        text_box_width(560px), text_wrap_word(), text_overflow_visible(),
        text_align_center(), text_align_middle(),
        writing_horizontal_tb(), orientation_mixed()
      ),
      text_path_none(),
      text_decoration(
        text_background_present(#111827cc, 12px),
        text_outline_present(#818cf8ff, 2px), shadow_none()
      ),
      [], animation(granularity, progressive)
    )
  }
}
