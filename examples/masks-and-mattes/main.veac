import "./masks.veac" as masks;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let circle = masks.sample(identifier("circle"), 0s, #ff2d95ff, mask_circle(), vector(0.56, 0.56));
  let rectangle = masks.sample(identifier("rectangle"), 1s, #00b4d8ff, mask_rectangle(), vector(0.7, 0.58));
  let ellipse = masks.sample(identifier("ellipse"), 2s, #ffc857ff, mask_ellipse(), vector(0.68, 0.44));
  let rounded = masks.sample(
    identifier("rounded"), 3s, #7bd389ff, mask_rounded_rectangle(0.14), vector(0.66, 0.52)
  );
  let polygon = masks.sample(
    identifier("polygon"), 4s, #9b5de5ff,
    mask_polygon([
      vector(0.5, 0.18), vector(0.82, 0.42), vector(0.68, 0.78),
      vector(0.32, 0.78), vector(0.18, 0.42)
    ]), vector(1.0, 1.0)
  );
  let path = masks.sample(
    identifier("path"), 5s, #f15bb5ff,
    mask_path([vector(0.18, 0.72), vector(0.5, 0.18), vector(0.82, 0.72)]),
    vector(1.0, 1.0)
  );
  let combined = masks.combined(identifier("combined"), 6s, #ff006eff);
  let alpha_content = showcase.solid(identifier("alpha-content"), #00bbf9ff, 8s, 2s);
  let content = visual_layer(
    identifier("content"), 1, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(circle).with_item(rectangle).with_item(ellipse).with_item(rounded)
    .with_item(polygon).with_item(path).with_item(combined).with_item(alpha_content);
  let radial_matte = item(
    identifier("radial-matte"), item_enabled(), during(6s, 2s),
    source_generated(generator_gradient(gradient_radial(
      vector(0.5, 0.5), 0.62,
      [gradient_stop(0%, #ffffffff), gradient_stop(100%, #000000ff)]
    ))), source_timing_native()
  );
  let alpha_source = item(
    identifier("alpha-source"), item_enabled(), during(8s, 2s),
    source_generated(generator_gradient(gradient_radial(
      vector(0.5, 0.5), 0.48,
      [gradient_stop(0%, #ffffffff), gradient_stop(100%, #00000000)]
    ))), source_timing_native()
  );
  let matte = visual_layer(
    identifier("matte"), 2, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(radial_matte).with_item(alpha_source);
  let labels = visual_layer(
    identifier("labels"), 3, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("explanation"), item_enabled(), during(0s, 10s),
    source_text(
      "几何蒙版全集，随后展示亮度轨道遮罩与反相透明度轨道遮罩",
      showcase.caption_style(font, 24px, 560px)
    ), source_timing_native()
  ));
  let base = visual_layer(
    identifier("base"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("canvas"), #101820ff, 0s, 10s));
  let timeline = sequence(
    identifier("main"), "蒙版与轨道遮罩",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(base).with_layer(content).with_layer(matte).with_layer(labels)
    .with_relation(relation_matte_item(
      identifier("soft-window"), radial_matte, combined, matte_luma(), false
    ))
    .with_relation(relation_matte_item(
      identifier("inverted-alpha"), alpha_source, alpha_content, matte_alpha(), true
    ));
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  project(identifier("masks-and-mattes"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output)
}
