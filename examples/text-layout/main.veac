import "./showcase.veac" as showcase;
import "./styles.veac" as styles;

fn copy(
  key: identifier, content: text, start: time, duration: time, style: TextStyle
) -> Item {
  item(
    key, item_enabled(), during(start, duration),
    source_text(content, style), source_timing_native()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let horizontal = copy(
    identifier("horizontal"), "中文排版 / مرحبا / VEAC", 0s, 2s,
    styles.horizontal(font)
  ).with_visual(styles.positioned(
    anchor_top_left(), vector(32.0, 32.0), vector(0.0, 0.0)
  ));
  let vertical_rl = copy(
    identifier("vertical-rl"), "从右向左竖排", 2s, 2s,
    styles.vertical(
      font, writing_vertical_rl(), orientation_upright(), #22d3eeff
    )
  ).with_visual(styles.positioned(
    anchor_top_right(), vector(48.0, 48.0), vector(1.0, 0.0)
  ));
  let vertical_lr = copy(
    identifier("vertical-lr"), "从左向右竖排", 2s, 2s,
    styles.vertical(
      font, writing_vertical_lr(), orientation_mixed(), #ff8a5bff
    )
  ).with_visual(styles.positioned(
    anchor_top_left(), vector(48.0, 48.0), vector(0.0, 0.0)
  ));
  let word_wrap = copy(
    identifier("word-wrap"), "按词换行 word wrap 分段换行", 2s, 2s,
    styles.word(font)
  ).with_visual(styles.positioned(
    anchor_bottom(), vector(0.0, 32.0), vector(0.5, 1.0)
  ));
  let path = copy(
    identifier("path"), "文字沿路径排版", 4s, 2s, styles.path(font)
  );
  let background = visual_layer(
    identifier("background"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("plate"), #164e63ff, 0s, 6s));
  let copy_layer = visual_layer(
    identifier("copy"), 1, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(horizontal).with_item(vertical_rl).with_item(vertical_lr)
    .with_item(word_wrap).with_item(path);
  let timeline = sequence(
    identifier("main"), "文本布局原语",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(background).with_layer(copy_layer);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  project(identifier("text-layout"), project_settings(600))
    .with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
