project transitions {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual scenes {
      item first {
        source generated solid { color #e63946ff; }
        record { at 0s; duration 2s; }
      }
      item second {
        source generated solid { color #457b9dff; }
        record { at 2s; duration 2s; }
      }
    }
    relation transition dissolve-cut {
      endpoints { from item first; to item second; }
      timing { duration 400ms; alignment centered; }
      style { dissolve; }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
