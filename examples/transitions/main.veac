import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let first = showcase.solid(identifier("first"), #e63946ff, 0s, 2s);
  let second = showcase.solid(identifier("second"), #457b9dff, 1600ms, 2400ms);
  let scenes = visual_layer(
    identifier("scenes"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(first).with_item(second);
  let labels = visual_layer(
    identifier("labels"), 1, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("explanation"), item_enabled(), during(0s, 4s),
    source_text(
      "居中叠化：两个真实画面在四百毫秒窗口内交叉混合",
      showcase.caption_style(font, 38px, 900px)
    ), source_timing_native()
  ));
  let timeline = sequence(
    identifier("main"), "基础居中叠化",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(scenes).with_layer(labels).with_relation(relation_transition(
    identifier("dissolve-cut"), first, second, transition_dissolve(400ms)
  ));
  let output = showcase.video(
    timeline, canvas(1280px, 720px), frame_rate(30, 1), false, false
  );
  project(identifier("transitions"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output)
}
