project nested-and-multicam {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;
  resource video host {
    locator local { path "assets/clip-a.mp4"; }
    streams { video auto; audio auto; }
  }
  resource video guest {
    locator local { path "assets/clip-b.mp4"; }
    streams { video auto; audio auto; }
  }

  multicam interview {
    sync audio { reference angle host-angle; }
    angle host-angle { source resource host; source-offset 0s; }
    angle guest-angle { source resource guest; source-offset 120ms; }
  }

  sequence intro {
    layer visual card {
      item slate {
        source generated solid { color #118ab2ff; }
        record { at 0s; duration 2s; }
      }
    }
  }

  sequence main {
    layer video program {
      item interview-cut {
        source multicam multicam interview {
          switch angle host-angle { at 0s; duration 2s; }
          switch angle guest-angle { at 2s; duration 2s; }
        }
        record { at 2s; duration 4s; }
        modifiers {
          layout canvas-fit {
            placement anchor { at center; inset { x 0px; y 0px; } }
            frame { width 1280px; height 720px; fit contain; }
          }
        }
      }
    }
    layer visual opener {
      item nested-intro {
        source sequence sequence intro;
        record { at 0s; duration 2s; }
      }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
