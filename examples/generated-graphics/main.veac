import "./shapes.veac" as shapes;
import "./showcase.veac" as showcase;

fn graphic(key: identifier, start: time, generator: Generator) -> Item {
  item(
    key, item_enabled(), during(start, 1s),
    source_generated(generator), source_timing_native()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let background = visual_layer(
    identifier("background"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("plate"), #111827ff, 0s, 9s));
  let graphics = visual_layer(
    identifier("graphics"), 1, placement_free(),
    showcase.state(), track_routing_default()
  )
    .with_item(graphic(identifier("solid"), 0s, generator_solid(#dc2626ff)))
    .with_item(graphic(identifier("transparent"), 1s, generator_transparent()))
    .with_item(graphic(identifier("linear"), 2s, shapes.linear()))
    .with_item(graphic(identifier("radial"), 3s, shapes.radial()))
    .with_item(graphic(identifier("rectangle"), 4s, shapes.rectangle()))
    .with_item(graphic(identifier("rounded"), 5s, shapes.rounded()))
    .with_item(graphic(identifier("ellipse"), 6s, shapes.ellipse()))
    .with_item(graphic(identifier("polygon"), 7s, shapes.polygon()))
    .with_item(graphic(identifier("path"), 8s, shapes.path()));
  let label = visual_layer(
    identifier("label"), 2, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("label"), item_enabled(), during(0s, 9s),
    source_text(
      "生成源序列：纯色、透明、渐变、矩形、圆角、椭圆、多边形与路径",
      showcase.caption_style(font, 24px, 600px)
    ), source_timing_native()
  ));
  let silence = audio_layer(
    identifier("silence"), 3, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("silence"), item_enabled(), during(0s, 9s),
    source_generated(generator_silence()), source_timing_native()
  ).with_audio(audio_style(
    scalar_constant(1.0), scalar_constant(0.0),
    audio_playback(false, false, pitch_preserve()), [], audio_crossfade_none()
  )));
  let timeline = sequence(
    identifier("main"), "生成图形原语",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(background).with_layer(graphics).with_layer(label).with_layer(silence);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), true, false
  );
  project(identifier("generated-graphics"), project_settings(600))
    .with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
