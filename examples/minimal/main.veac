project minimal {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual base {
      item background {
        source generated solid { color #1b3a57ff; }
        record { at 0s; duration 3s; }
      }
    }
  }
}
