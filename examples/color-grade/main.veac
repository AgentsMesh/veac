project color-grade {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual picture {
      item shot {
        source generated gradient linear {
          from 0% 50%; to 100% 50%;
          stop 0% #33415cff; stop 100% #7d8597ff;
        }
        record { at 0s; duration 4s; }
        modifiers {
          color balanced {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            basic {
              exposure 0.25stops;
              temperature 6800k;
              tint 0.04;
              highlights -0.08;
              shadows 0.12;
              fade 3%;
            }
          }
        }
      }
    }
  }
}
