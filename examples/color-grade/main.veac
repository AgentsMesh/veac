project color-grade {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual picture {
      item reference {
        source generated gradient linear {
          from 0% 50%; to 100% 50%;
          stop 0% #33415cff; stop 100% #7d8597ff;
        }
        record { at 0s; duration 2s; }
      }
      item balanced {
        source generated gradient linear {
          from 0% 50%; to 100% 50%;
          stop 0% #33415cff; stop 100% #7d8597ff;
        }
        record { at 2s; duration 2s; }
        modifiers {
          color balanced {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            basic {
              exposure 0.4stops;
              temperature 4800k;
              tint 0.08;
              highlights -0.18;
              shadows 0.28;
              fade 4%;
            }
          }
        }
      }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
