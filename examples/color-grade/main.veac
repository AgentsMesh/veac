import "./styles.veac" as styles;
import "./showcase.veac" as showcase;

fn card(key: identifier, start: time) -> Item {
  item(
    key, item_enabled(), during(start, 2s),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.5), vector(1.0, 0.5),
      [gradient_stop(0%, #33415cff), gradient_stop(100%, #7d8597ff)]
    ))), source_timing_native()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let picture = visual_layer(
    identifier("picture"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(card(identifier("reference"), 0s))
    .with_item(card(identifier("balanced"), 2s).with_visual(styles.balanced()));
  let labels = visual_layer(
    identifier("labels"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("reference-label"), item_enabled(), during(0s, 2s),
    source_text("原始色彩参照", showcase.caption_style(font, 38px, 600px)),
    source_timing_native()
  )).with_item(item(
    identifier("grade-label"), item_enabled(), during(2s, 2s),
    source_text("曝光、色温、色调、高光、阴影与褪色", showcase.caption_style(font, 38px, 800px)),
    source_timing_native()
  ));
  let timeline = sequence(
    identifier("main"), "基础色彩校正",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(picture).with_layer(labels);
  let output = showcase.video(
    timeline, canvas(1280px, 720px), frame_rate(30, 1), false, false
  );
  project(identifier("color-grade"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output)
}
