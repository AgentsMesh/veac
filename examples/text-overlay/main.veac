import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let background = visual_layer(
    identifier("background"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("plate"), #172554ff, 0s, 4s));
  let copy = visual_layer(
    identifier("copy"), 1, placement_free(),
    showcase.state(), track_routing_default()
  )
    .with_item(item(
      identifier("title"), item_enabled(), during(0s, 2s),
      source_text(
        "文本叠加：背景、描边与安全换行",
        showcase.caption_style(font, 32px, 560px)
      ), source_timing_native()
    ))
    .with_item(item(
      identifier("detail"), item_enabled(), during(2s, 2s),
      source_text(
        "第二段文案证明时间范围与样式独立生效",
        showcase.caption_style(font, 24px, 520px)
      ), source_timing_native()
    ));
  let timeline = sequence(
    identifier("main"), "文本叠加",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(background).with_layer(copy);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  project(identifier("text-overlay"), project_settings(600))
    .with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
