project text-overlay {
  settings {
    timebase 1/1000;
    canvas 1920px by 1080px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item base {
        source generated solid { color #1b263bff; }
        record { at 0s; duration 5s; }
      }
    }
    layer visual typography {
      item title {
        source text {
          content "Agent-friendly video editing";
          style {
            font family "Inter";
            fallback-font family "Arial";
            size 68px;
            weight bold;
            fill #ffffffff;
            tracking 1px;
            line-height 1.2;
            background { color #00000099; padding 18px; }
            outline { color #00b4d8ff; width 2px; }
            shadow {
              color #000000ff; opacity 65%; blur 8px;
              offset { x 4px; y 6px; }
            }
          }
          layout {
            box-width 1540px;
            box-height 240px;
            wrap word;
            overflow ellipsis;
            horizontal-align center;
            vertical-align middle;
          }
        }
        record { at 0s; duration 5s; }
      }
    }
  }
}
