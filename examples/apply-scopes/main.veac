import "./scopes.veac" as scopes;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let background = item(
    identifier("background"), item_enabled(), during(0s, 6s),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.0), vector(1.0, 1.0),
      [gradient_stop(0%, #264653ff), gradient_stop(100%, #2a9d8fff)]
    ))), source_timing_native()
  );
  let accent = showcase.solid(identifier("accent"), #ef476fdd, 0s, 6s)
    .with_visual(scopes.accent_style());
  let base = visual_layer(
    identifier("base"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(background);
  let overlay = visual_layer(
    identifier("overlay"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(accent);
  let labels = visual_layer(
    identifier("labels"), 2, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("band-label"), item_enabled(), during(0s, 2s),
    source_text("作用域：合成时间带", showcase.caption_style(font, 38px, 600px)),
    source_timing_native()
  )).with_item(item(
    identifier("layer-label"), item_enabled(), during(2s, 2s),
    source_text("作用域：单个图层", showcase.caption_style(font, 38px, 600px)),
    source_timing_native()
  )).with_item(item(
    identifier("items-label"), item_enabled(), during(4s, 2s),
    source_text("作用域：精确条目集合", showcase.caption_style(font, 38px, 700px)),
    source_timing_native()
  ));
  let selected = relation_group(identifier("selected-items"), [background, accent]);
  let timeline = sequence(
    identifier("main"), "三类应用作用域",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(base).with_layer(overlay).with_layer(labels).with_relation(selected)
    .with_apply(scopes.composite_band(base, overlay))
    .with_apply(scopes.layer(overlay))
    .with_apply(scopes.items(background, accent));
  let output = showcase.video(
    timeline, canvas(1280px, 720px), frame_rate(30, 1), false, false
  );
  project(identifier("apply-scopes"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output)
}
