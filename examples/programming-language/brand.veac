module {
  import "./showcase.veac" as showcase;

  export enum Mood {
    Calm,
    Accent { color: color, },
  }

  export enum Locale {
    zh-Hans,
    zh-Hant,
  }

  export struct Card {
    key: identifier,
    at: time,
    duration: time,
    topic: text,
    detail: text,
    mood: Mood,
  }

  impl Card @presentation {
    export fn title(self, separator: text) -> text {
      self.topic + separator + self.detail
    }

    export fn background(self) -> color {
      match self.mood {
        Mood.Calm => #2b6574ff,
        Mood.Accent { color } => color,
      }
    }
  }

  export fn card_span(base: time, padding: time) -> time {
    clamp(add_padding(base, padding), 2s, 3s)
  }

  export fn card(
    key: identifier, at: time, title: text, detail: text,
    duration: time = 3s, mood: Mood = Mood.Calm,
  ) -> Card {
    Card {
      key: key, at: at, duration: duration,
      topic: title, detail: detail, mood: mood,
    }
  }

  export fn component_prefix(locale: Locale) -> text {
    match locale {
      Locale.zh-Hans => "组件化：",
      Locale.zh-Hant => "元件化：",
    }
  }

  fn add_padding(base: time, padding: time) -> time { base + padding }

  export fn first_card(duration: time) -> Card {
    card(
      key: identifier("first"), at: 0s, title: "结构与方法",
      detail: "静态类型组件", duration: duration,
    )
  }

  export fn second_card(duration: time, accent: color) -> Card {
    card(
      key: identifier("second"), at: duration, title: "枚举与控制流",
      detail: "穷尽匹配生成", duration: duration,
      mood: Mood.Accent { color: accent, },
    )
  }

  export fn backdrop(card: Card) -> Item {
    item(
      card.key, item_enabled(), during(card.at, card.duration),
      source_generated(generator_solid(card.background())), source_timing_native()
    )
  }

  export fn animated(card: Card) -> Item {
    let visual = backdrop(card);
    animate visual-opacity on clip(visual) {
      sample_curve_ease_in_out(
        clamp(progress * 1.5, 0.0, 1.0), [(0.0, 0.0), (1.0, 1.0)]
      )
    }
  }

  export fn copy(card: Card, font: Resource, label: text) -> Item {
    item(
      card.key, item_enabled(), during(card.at, card.duration),
      source_text(label, showcase.caption_style(font, 52px, 1100px)),
      source_timing_native()
    )
  }
}
