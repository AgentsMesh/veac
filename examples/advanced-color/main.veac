project advanced-color {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;
  resource lut-3d cinematic { locator local { path "assets/cinematic.cube"; } }
  resource lut-1d tone-curve { locator local { path "assets/tone-curve.cube"; } }

  sequence color-card {
    layer visual card-source {
      item chart {
        source generated gradient linear {
          from 0% 50%; to 100% 50%;
          stop 0% #14213db3; stop 35% #3a86ffb3;
          stop 68% #ff4d8db3; stop 100% #ffd166b3;
        }
        record { at 0s; duration 8s; }
      }
    }
  }

  sequence main {
    layer visual background {
      item alpha-check {
        source generated gradient linear {
          from 50% 0%; to 50% 100%;
          stop 0% #050505ff; stop 48% #050505ff;
          stop 52% #fafafaff; stop 100% #fafafaff;
        }
        record { at 0s; duration 8s; }
      }
    }
    layer visual comparisons {
      item reference {
        source sequence sequence color-card;
        record { at 0s; duration 1s; }
      }
      item hsl-only {
        source sequence sequence color-card;
        record { at 1s; duration 1s; }
        modifiers {
          color red-isolation {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            hsl { range red; hue 18deg; saturation 0.3; lightness 0.06; }
          }
        }
      }
      item curves-only {
        source sequence sequence color-card;
        record { at 2s; duration 1s; }
        modifiers {
          color curve-contrast {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            curves {
              interpolation monotonic;
              curve luma { point 0% 3%; point 45% 52%; point 100% 96%; }
              curve red { point 0% 0%; point 50% 56%; point 100% 100%; }
            }
          }
        }
      }
      item wheels-only {
        source sequence sequence color-card;
        record { at 3s; duration 1s; }
        modifiers {
          color split-tone {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            wheels { lift 0 0 0.04; gamma 0.03 0 0; gain 0.05 0.02 -0.01; }
          }
        }
      }
      item full-grade {
        source sequence sequence color-card;
        record { at 4s; duration 2s; }
        modifiers {
          color cinematic {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            basic {
              exposure 0.35stops; temperature 4800k; tint 0.08;
              highlights -0.2; shadows 0.18; fade 4%;
            }
            matrix {
              red 1.08 0.02 0; green 0.01 0.96 0.03;
              blue 0 0.04 0.9; offset 0.01 0 0.02;
            }
            hsl { range red; hue 12deg; saturation 0.18; lightness 0.04; }
            curves {
              interpolation monotonic;
              curve luma { point 0% 3%; point 45% 52%; point 100% 96%; }
            }
            wheels { lift 0 0 0.04; gamma 0.03 0 0; gain 0.05 0.02 -0.01; }
            lut { resource cinematic; interpolation tetrahedral; }
          }
        }
      }
      item tone-curve {
        source sequence sequence color-card;
        record { at 6s; duration 2s; }
        modifiers {
          color one-dimensional-lut {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            lut { resource tone-curve; interpolation linear; }
          }
        }
      }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
