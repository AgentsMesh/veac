import "./showcase.veac" as showcase;
import "./styles.veac" as styles;

fn audio_item(
  key: identifier, source: Resource, start: time, style: AudioStyle
) -> Item {
  item(
    key, item_enabled(), during(start, 2s),
    source_media(source), source_timing_native()
  ).with_audio(style)
}

fn label_item(
  key: identifier, content: text, start: time, font: Resource
) -> Item {
  item(
    key, item_enabled(), during(start, 2s),
    source_text(content, showcase.caption_style(font, 28px, 560px)),
    source_timing_native()
  ).with_visual(styles.label_visual())
}

fn main(context: Context) -> Project {
  let tone = audio_resource(
    identifier("tone"), resource_file("assets/tone.wav"),
    sha256("5c3aaa006e4c341feddf589f9eb0ba3b215c60353e491abf8f06f4bee4478cfc"),
    stream_auto()
  );
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let voice = audio_item(identifier("voice"), tone, 0s, styles.voice());
  let music = audio_item(identifier("music"), tone, 2s, styles.music())
    .with_effect(audio_normalize_effect(
      identifier("normalize"), effect_enabled(effect_window_full()), -14.0
    ));
  let key = audio_item(identifier("key"), tone, 2s, styles.key());
  let bus = audio_bus(identifier("music-bus"));
  let voice_track = audio_layer(
    identifier("voice"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(voice);
  let music_track = audio_layer(
    identifier("music"), 1, placement_free(),
    showcase.state(), track_routing_bus(bus)
  ).with_item(music);
  let key_track = audio_layer(
    identifier("key"), 2, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(key);
  let background = visual_layer(
    identifier("background"), 3, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("plate"), #3f3f46ff, 0s, 4s));
  let label = visual_layer(
    identifier("label"), 4, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(label_item(
    identifier("voice-label"), "自动化、均衡与动态处理", 0s, font
  )).with_item(label_item(
    identifier("route-label"), "三种淡变、总线路由与侧链压低", 2s, font
  ));
  let ducking = relation_sidechain_track(
    identifier("ducking"), key_track, music,
    sidechain_settings(-24.0, 4.0, 10.0, 120.0, sidechain_window_full())
  );
  let timeline = sequence(
    identifier("main"), "音频处理链",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(voice_track).with_layer(music_track).with_layer(key_track)
    .with_layer(background).with_layer(label).with_relation(ducking);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), true, false
  );
  project(identifier("audio-processing"), project_settings(600))
    .with_resource(tone).with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
