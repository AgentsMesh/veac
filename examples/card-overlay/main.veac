project card-overlay {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual base {
      item background {
        source generated gradient linear {
          from 0% 20%; to 100% 80%;
          stop 0% #0b132bff; stop 100% #1c2541ff;
        }
        record { at 0s; duration 4s; }
      }
    }
    layer visual card {
      item panel {
        source generated shape {
          geometry rounded-rectangle { bounds 0% 0% 100% 100%; radius 18px; }
          fill solid #f7f7f2ee;
          stroke 3px solid #5bc0beff;
        }
        record { at 0s; duration 4s; }
        modifiers {
          layout card-frame {
            placement absolute { position { x 280px; y 170px; } }
            frame { width 720px; height 380px; fit contain; }
          }
          composite translucent { opacity 92%; z-index 10; }
        }
      }
    }
  }
}
