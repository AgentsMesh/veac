import "./timing.veac" as timing;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let reel = video_resource(
    identifier("reel"), resource_file("assets/reel.mp4"),
    sha256("18e150f526332efca23a274a1d39128c008cc9b9ec342bb8d530bbf8a1119586"),
    stream_intent(stream_auto(), stream_disabled())
  );
  let boundary_layer = visual_layer(
    identifier("frames"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("first-frame"), #d1495bff, 0s, 500ms))
    .with_item(showcase.solid(identifier("last-frame"), #00798cff, 500ms, 500ms));
  let boundary = sequence(
    identifier("boundary-source"), "边界帧素材",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(boundary_layer);
  let linear = timing.media(
    identifier("linear-trim"), 0s, 1500ms, reel,
    source_mapping(
      source_time_linear(500ms, 1.0, 1, playback_forward()),
      frame_nearest(), out_of_range_strict()
    )
  );
  let ramp = timing.media(
    identifier("speed-ramp"), 1500ms, 1500ms, reel,
    source_mapping(source_time_curve([
      source_time_segment(375ms, 2s, 2250ms, segment_linear()),
      source_time_segment(375ms, 2250ms, 2750ms, segment_linear()),
      source_time_segment(375ms, 2750ms, 3500ms, segment_linear()),
      source_time_segment(375ms, 3500ms, 4500ms, segment_linear())
    ]), frame_blend(), out_of_range_strict())
  );
  let freeze = item(
    identifier("freeze"), item_enabled(), during(3s, 1s),
    source_freeze_frame(reel, 5s), source_timing_native()
  ).with_visual(timing.fit());
  let fast = timing.media(
    identifier("fast-forward"), 4s, 1s, reel,
    source_mapping(
      source_time_linear(5500ms, 2.0, 1, playback_forward()),
      frame_blend(), out_of_range_strict()
    )
  );
  let hold_first = timing.nested(
    identifier("hold-first"), 5s, 1s, boundary,
    source_time_linear(-1s, 1.0, 1, playback_forward()), out_of_range_hold_first()
  );
  let hold_last = timing.nested(
    identifier("hold-last"), 6s, 1s, boundary,
    source_time_linear(1s, 1.0, 1, playback_forward()), out_of_range_hold_last()
  );
  let hold_both = timing.nested(
    identifier("hold-both"), 7s, 2s, boundary,
    source_time_linear(-1s, 2.0, 1, playback_forward()), out_of_range_hold_both()
  );
  let edits = video_layer(
    identifier("edits"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(linear).with_item(ramp).with_item(freeze).with_item(fast)
    .with_item(hold_first).with_item(hold_last).with_item(hold_both);
  let timeline = sequence(
    identifier("main"), "源时间映射与越界策略",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(edits);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  project(identifier("timeline-source-time"), project_settings(600))
    .with_resource(reel)
    .with_sequence(boundary).with_sequence(timeline).entry(timeline).with_delivery(output)
}
