import "./outputs.veac" as outputs;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let tone = audio_resource(
    identifier("codec-tone"), resource_file("assets/codec-tone.wav"),
    sha256("c165b274e0a6189d0d35d55bc746fa03a6e3211adf13ed21653fdd383aaffb10"),
    stream_auto()
  );
  let picture = visual_layer(
    identifier("picture"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("color-reference"), item_enabled(), during(0s, 1s),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.5), vector(1.0, 0.5), [
        gradient_stop(0%, #071a52ff), gradient_stop(35%, #086972ff),
        gradient_stop(70%, #f8b500ff), gradient_stop(100%, #ff4b5cff)
      ]
    ))), source_timing_native()
  ));
  let audio = audio_layer(
    identifier("reference"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("tone"), item_enabled(), during(0s, 1s),
    source_media(tone), source_timing_native()
  ));
  let labels = caption_layer(
    identifier("labels"), 2, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("codecs"), item_enabled(), during(0s, 1s),
    source_caption("十位深与网页视频双交付", showcase.caption_style(font, 36px, 520px)),
    source_timing_native()
  ));
  let timeline = sequence(
    identifier("main"), "视频编码矩阵",
    sequence_settings(canvas(640px, 360px), frame_rate(24, 1), 48000)
  ).with_layer(picture).with_layer(audio).with_layer(labels);
  let output = outputs.matrix(timeline);
  project(identifier("delivery-codec-matrix"), project_settings(600))
    .with_resource(font).with_resource(tone)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
