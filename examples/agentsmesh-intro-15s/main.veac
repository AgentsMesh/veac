project agentsmesh-intro {
  settings {
    timebase 1/1000;
    canvas 1920px by 1080px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item field {
        source generated gradient linear {
          from 0% 20%; to 100% 80%;
          stop 0% #071a2bff; stop 100% #123a46ff;
        }
        record { at 0s; duration 15s; }
      }
    }
    layer visual titles {
      item brand {
        source text {
          content "AgentsMesh";
          style {
            font family "Inter"; size 112px; weight bold; fill #ffffffff;
            shadow {
              color #000000ff; opacity 60%; blur 12px;
              offset { x 4px; y 8px; }
            }
          }
          layout {
            box-width 1600px; box-height 300px;
            horizontal-align center; vertical-align middle;
          }
          animation {
            unit grapheme; stagger 45ms; reveal 100%; opacity 100%;
            transform {
              position { x 0px; y 20px; }
              scale { x 100%; y 100%; }
              rotation 0deg;
            }
          }
        }
        record { at 0s; duration 5s; }
      }
      item promise {
        source text {
          content "Video editing as typed, reviewable code";
          style { font family "Inter"; size 64px; fill #90e0efff; }
          layout {
            box-width 1600px; box-height 260px; wrap word;
            horizontal-align center; vertical-align middle;
          }
        }
        record { at 5s; duration 10s; }
      }
    }
    layer audio bed {
      item silence { source generated silence; record { at 0s; duration 15s; } }
    }
    layer caption subtitles {
      item caption {
        source caption {
          content "AgentsMesh: video editing as typed, reviewable code.";
          style { font family "Inter"; size 48px; fill #ffffffff; }
        }
        record { at 5s; duration 10s; }
      }
    }
  }

  output video preview {
    sequence main;
    file-name "agentsmesh-intro.mp4";
    encoding {
      container mp4;
      optimize-for-streaming true;
      video { codec h264; pixel-format yuv420p; }
      audio { codec aac; sample-rate 48000; channels 2; }
      captions burn-in;
    }
  }
}
