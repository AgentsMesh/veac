project agentsmesh-intro-15s {
  settings {
    timebase 1/1000;
    canvas 1920px by 1080px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item backdrop {
        source generated gradient linear {
          from 0% 0%; to 100% 100%;
          stop 0% #102a43ff;
          stop 55% #0f766eff;
          stop 100% #22c55eff;
        }
        record { at 0s; duration 15s; }
      }
    }

    layer visual brand {
      item title {
        source text {
          content "AgentsMesh";
          style {
            font family "Arial";
            weight bold;
            size 112px;
            fill #f7fbffff;
            shadow {
              color #001f2dff; opacity 80%; blur 18px;
              offset { x 0px; y 10px; }
            }
          }
          layout {
            box-width 1600px;
            box-height 300px;
            wrap none;
            overflow visible;
            horizontal-align center;
            vertical-align middle;
          }
          animation {
            unit grapheme;
            stagger 45ms;
            reveal curve {
              key brand-hidden { at 0s; value 0%; interpolation linear; }
              key brand-revealed { at 900ms; value 100%; interpolation ease-out; }
            }
            opacity curve {
              key brand-transparent { at 0s; value 0%; interpolation linear; }
              key brand-opaque { at 700ms; value 100%; interpolation ease-out; }
            }
            transform {
              position curve {
                key brand-low {
                  at 0s; value { x 0px; y 28px; } interpolation ease-out;
                }
                key brand-centered {
                  at 900ms; value { x 0px; y 0px; } interpolation ease-out;
                }
              }
              scale curve {
                key brand-small {
                  at 0s; value { x 88%; y 88%; } interpolation ease-out;
                }
                key brand-full {
                  at 900ms; value { x 100%; y 100%; } interpolation ease-out;
                }
              }
              rotation 0deg;
            }
          }
        }
        record { at 0s; duration 5s; }
      }
    }

    layer visual promise {
      item promise {
        source text {
          content "Build systems once. Ship typed products repeatedly.";
          style {
            font family "Arial";
            weight bold;
            size 64px;
            fill #d8f3efff;
            shadow {
              color #001f2dff; opacity 67%; blur 10px;
              offset { x 0px; y 6px; }
            }
          }
          layout {
            box-width 1600px;
            box-height 260px;
            wrap word;
            overflow visible;
            horizontal-align center;
            vertical-align middle;
          }
        }
        record { at 5s; duration 10s; }
        modifiers {
          layout promise-placement {
            placement absolute { position { x 960px; y 490px; } }
            frame { width 1600px; height 260px; fit contain; }
          }
        }
      }
    }

    layer caption captions {
      item caption {
        source caption {
          content "Video editing as typed, reviewable code.";
          style {
            font family "Arial";
            weight bold;
            size 44px;
            fill #ffffffff;
            background { color #001f2dcc; padding 18px; }
          }
          layout {
            box-width 1600px;
            box-height 160px;
            wrap word;
            overflow visible;
            horizontal-align center;
            vertical-align bottom;
          }
        }
        record { at 2s; duration 10s; }
        modifiers {
          layout caption-placement {
            placement absolute { position { x 960px; y 914px; } }
            frame { width 1600px; height 160px; fit contain; }
          }
        }
      }
    }
  }
}
