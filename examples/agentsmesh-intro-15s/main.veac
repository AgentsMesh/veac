import "./styles.veac" as styles;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let background = visual_layer(
    identifier("background"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("backdrop"), item_enabled(), during(0s, 15s),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.0), vector(1.0, 1.0), [
        gradient_stop(0%, #102a43ff), gradient_stop(55%, #0f766eff),
        gradient_stop(100%, #22c55eff)
      ]
    ))), source_timing_native()
  ));
  let brand = visual_layer(
    identifier("brand"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("title"), item_enabled(), during(0s, 5s),
    source_text("智能体协作网", styles.title(font)), source_timing_native()
  ));
  let promise = visual_layer(
    identifier("promise"), 2, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("promise"), item_enabled(), during(5s, 10s),
    source_text("一次构建系统，持续交付类型化产品。", styles.promise(font)),
    source_timing_native()
  ));
  let captions = caption_layer(
    identifier("captions"), 3, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("caption"), item_enabled(), during(2s, 10s),
    source_caption("视频编辑成为类型化、可审查的代码。", styles.caption(font)),
    source_timing_native()
  ).with_visual(styles.caption_visual()));
  let timeline = sequence(
    identifier("main"), "智能体协作网十五秒片头",
    sequence_settings(canvas(1920px, 1080px), frame_rate(30, 1), 48000)
  ).with_layer(background).with_layer(brand).with_layer(promise).with_layer(captions);
  let output = showcase.video(
    timeline, canvas(1920px, 1080px), frame_rate(30, 1), false, true
  );
  project(identifier("agentsmesh-intro-15s"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output)
}
