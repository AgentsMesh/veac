project hello-world {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item field {
        source generated gradient linear {
          from 50% 0%; to 50% 100%;
          stop 0% #143642ff; stop 100% #0f1a20ff;
        }
        record { at 0s; duration 4s; }
      }
    }
    layer visual title {
      item greeting {
        source text {
          content "你好，VEAC";
          style {
            font family "Arial Unicode MS";
            fallback-font family "Arial";
            size 72px; fill #ffffffff;
          }
          layout {
            box-width 1000px;
            box-height 180px;
            horizontal-align center;
            vertical-align middle;
          }
        }
        record { at 0s; duration 4s; }
      }
    }
  }

  delivery preview {
    sequence main;
    raster { canvas 1280px by 720px; frame-rate 30fps; captions discard; }
    artifact video preview {
      target file "preview.mp4";
      mux mp4 {
        layout standard;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio none;
        passes single;
        accelerator auto;
      }
    }
  }
}
