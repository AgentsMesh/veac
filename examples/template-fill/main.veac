import "./showcase.veac" as showcase;

fn fill_style() -> VisualStyle {
  visual_style(
    visual_layout(
      placement_anchor(anchor_center(), vector(0.0, 0.0)),
      frame_sized(1280px, 720px, fit_cover()),
      transform_2d(
        transform_motion(
          point_constant(point(0px, 0px)), vector_constant(vector(1.0, 1.0)),
          angle_constant(0deg)
        ),
        transform_geometry(vector(0.0, 0.0), flip_none(), vector(0.5, 0.5), crop_none())
      )
    ),
    visual_surface(percent_constant(100%), compositing(0, blend_normal()), card_none()),
    [], color_pipeline_none()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let placeholder = video_resource(
    identifier("hero-placeholder"), resource_file("assets/placeholder.mp4"),
    sha256("4c84368a6bf27bf3dc4f915588c9ca1f94e634ae00dfba3076bca33f09fbd174"),
    stream_intent(stream_auto(), stream_disabled())
  );
  let hero = item(
    identifier("hero"), item_enabled(), during(0s, 6s),
    source_media(placeholder), source_timing_mapped(source_mapping(
      source_time_linear(0s, 1.0, 1, playback_forward()),
      frame_nearest(), out_of_range_strict()
    ))
  ).with_visual(fill_style()).with_template(template_contract(
    slot_video(), fill_fit_duration(), "主视觉媒体",
    source_duration_at_least(2s), template_text_locked()
  ));
  let media = video_layer(
    identifier("media-slots"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(hero);
  let title = item(
    identifier("title"), item_enabled(), during(0s, 6s),
    source_text(
      "可替换标题",
      showcase.caption_style(font, 56px, 900px)
    ), source_timing_native()
  ).with_template(template_contract(
    slot_text(), fill_fit_duration(), "主标题文本",
    source_duration_any(), template_text_editable()
  ));
  let text = visual_layer(
    identifier("text-slots"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(title);
  let timeline = sequence(
    identifier("main"), "模板填充工作流",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(media).with_layer(text);
  let output = showcase.video(
    timeline, canvas(1280px, 720px), frame_rate(30, 1), false, false
  );
  project(identifier("template-fill"), project_settings(600))
    .with_resource(font).with_resource(placeholder)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
