project all-features {
  settings {
    timebase 1/1000;
    canvas 1920px by 1080px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;
  resource video footage {
    locator local { path "assets/footage.mp4"; }
    streams { video auto; audio auto; }
  }
  resource audio music {
    locator local { path "assets/music.wav"; }
    streams { video disabled; audio auto; }
  }

  sequence main {
    layer video picture {
      item shot {
        source media resource footage;
        record { at 0s; duration 8s; }
        mapping linear { from 2s; to 10s; }
        modifiers {
          layout canvas-fill {
            placement anchor { at center; inset { x 0px; y 0px; } }
            frame { width 1920px; height 1080px; fit cover; }
          }
          color grade {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            basic {
              exposure 0.1stops; temperature 6600k; tint 0;
              highlights -0.04; shadows 0.06; fade 1%;
            }
          }
        }
      }
    }
    layer visual graphics {
      item lower-third {
        source generated solid { color #03045edd; }
        record { at 1s; duration 5s; }
        modifiers {
          layout lower-third-frame {
            placement anchor { at bottom; inset { x 0px; y 80px; } }
            frame { width 1500px; height 180px; fit fill; }
          }
          transform lower-third-pivot { anchor { x 0.5; y 1; } }
          composite top { opacity 95%; z-index 20; blend normal; }
        }
      }
    }
    layer audio score {
      route bus music-bus;
      item music-item {
        source media resource music;
        record { at 0s; duration 8s; }
        mapping linear { from 0s; to 8s; }
        modifiers {
          audio mix {
            gain -6db; pan 0; muted false; normalize true; pitch preserve;
            crossfade { fade-in 250ms; fade-out 500ms; curve equal-power; }
            processor limiter { ceiling -1db; attack 1ms; release 80ms; }
          }
        }
      }
    }
    layer caption subtitles {
      item cue {
        source caption {
          content "一种语言，一份类型化中间表示，一套渲染计划。";
          style {
            font family "Arial Unicode MS";
            fallback-font family "Arial";
            size 48px; fill #ffffffff;
            background { color #000000cc; padding 20px; }
          }
        }
        record { at 0s; duration 8s; }
        modifiers {
          layout caption-placement {
            placement absolute { position { x 960px; y 850px; } }
            frame { width 1500px; height 140px; fit contain; }
          }
        }
      }
    }
    relation group edit-unit { members { item shot; item music-item; } }
    relation av-link linked-av {
      endpoints { video item shot; audio { item music-item; } }
    }
  }

  delivery master {
    sequence main;
    raster { canvas 1920px by 1080px; frame-rate 30fps; captions burn-in; }
    artifact video master {
      target file "all-features.mp4";
      mux mp4 {
        layout fast-start;
        video h264 {
          pixel-format yuv420p;
          alpha opaque;
          color-space source;
          rate-control crf { value 23; }
          gop automatic;
          b-frames automatic;
          profile automatic;
          level automatic;
        }
        audio aac {
          sample-rate 48khz;
          channel-layout stereo;
        }
        passes single;
        accelerator auto;
      }
    }
  }
}
