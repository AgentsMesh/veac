import "./outputs.veac" as outputs;
import "./styles.veac" as styles;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let footage = video_resource(
    identifier("footage"), resource_file("assets/scene1.mp4"),
    sha256("9f8cf7a52504cfaf9003bf4dbc850136d3ab320dd09a45fe78a1fbc3dc789fb7"),
    stream_intent(stream_auto(), stream_disabled())
  );
  let music = audio_resource(
    identifier("music"), resource_file("assets/bgm.m4a"),
    sha256("b86576b294557828c34f5801448f34cd68e9daa3350aa464d84f8cd3e48040d5"),
    stream_auto()
  );
  let shot = item(
    identifier("shot"), item_enabled(), during(0s, 8s), source_media(footage),
    source_timing_mapped(source_mapping(
      source_time_linear(2s, 1.0, 1, playback_forward()),
      frame_nearest(), out_of_range_strict()
    ))
  ).with_visual(styles.picture());
  let picture = video_layer(
    identifier("picture"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(shot);
  let lower_third = showcase.solid(identifier("lower-third"), #03045edd, 1s, 5s)
    .with_visual(styles.lower_third());
  let graphics = visual_layer(
    identifier("graphics"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(lower_third);
  let music_item = item(
    identifier("music-item"), item_enabled(), during(0s, 8s), source_media(music),
    source_timing_mapped(source_mapping(
      source_time_linear(0s, 1.0, 1, playback_forward()),
      frame_nearest(), out_of_range_strict()
    ))
  ).with_audio(styles.music());
  let bus = audio_bus(identifier("music-bus"));
  let score = audio_layer(
    identifier("score"), 2, placement_free(), showcase.state(), track_routing_bus(bus)
  ).with_item(music_item);
  let subtitles = caption_layer(
    identifier("subtitles"), 3, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("cue"), item_enabled(), during(0s, 8s),
    source_caption(
      "一种语言，一份类型化中间表示，一套渲染计划。",
      styles.caption_text(font)
    ), source_timing_native()
  ).with_visual(styles.caption()));
  let timeline = sequence(
    identifier("main"), "跨机制集成",
    sequence_settings(canvas(1920px, 1080px), frame_rate(30, 1), 48000)
  ).with_layer(picture).with_layer(graphics).with_layer(score).with_layer(subtitles)
    .with_relation(relation_group(identifier("edit-unit"), [shot, music_item]))
    .with_relation(relation_av_link(identifier("linked-av"), shot, [music_item]));
  let output = outputs.master(timeline);
  project(identifier("all-features"), project_settings(600))
    .with_resource(font).with_resource(footage).with_resource(music)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
