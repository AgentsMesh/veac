project all-features {
  settings {
    timebase 1/1000;
    canvas 1920px by 1080px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;
  resource video footage {
    locator local { path "assets/footage.mp4"; }
    streams { video auto; audio auto; }
  }
  resource audio music {
    locator local { path "assets/music.wav"; }
    streams { video disabled; audio auto; }
  }

  sequence main {
    layer video picture {
      item shot {
        source media resource footage;
        record { at 0s; duration 8s; }
        mapping linear { from 2s; to 10s; }
        modifiers {
          color grade {
            input-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            working-space { primaries bt709; transfer linear; matrix rgb; range full; }
            output-space { primaries bt709; transfer bt709; matrix bt709; range limited; }
            basic {
              exposure 0.1stops; temperature 6600k; tint 0;
              highlights -0.04; shadows 0.06; fade 1%;
            }
          }
        }
      }
    }
    layer visual graphics {
      item lower-third {
        source generated solid { color #03045edd; }
        record { at 1s; duration 5s; }
        modifiers {
          composite top { opacity 95%; z-index 20; blend normal; }
        }
      }
    }
    layer audio score {
      route bus music-bus;
      item music-item {
        source media resource music;
        record { at 0s; duration 8s; }
        mapping linear { from 0s; to 8s; }
        modifiers {
          audio mix {
            gain -6db; pan 0; muted false; normalize true; pitch preserve;
            crossfade { fade-in 250ms; fade-out 500ms; curve equal-power; }
            processor limiter { ceiling -1db; attack 1ms; release 80ms; }
          }
        }
      }
    }
    layer caption subtitles {
      item cue {
        source caption {
          content "One language, one typed IR, one render plan.";
          style { font family "Inter"; size 48px; fill #ffffffff; }
        }
        record { at 0s; duration 8s; }
      }
    }
    relation group edit-unit { members { item shot; item music-item; } }
    relation av-link linked-av {
      endpoints { video item shot; audio { item music-item; } }
    }
  }

  output video master {
    sequence main; file-name "all-features.mp4";
    encoding {
      container mp4; optimize-for-streaming true;
      video { codec h264; pixel-format yuv420p; }
      audio { codec aac; sample-rate 48000; channels 2; }
      captions burn-in;
    }
  }
}
