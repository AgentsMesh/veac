project executable-mechanisms {
  settings {
    timebase 1/1000;
    canvas 96px by 54px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  sequence main {
    layer visual background {
      item warm {
        source generated gradient linear {
          from 0% 50%; to 100% 50%; stop 0% #ff0000ff; stop 100% #ffff00ff;
        }
        record { at 0s; duration 1s; }
      }
      item cool {
        source generated gradient linear {
          from 0% 50%; to 100% 50%; stop 0% #0000ffff; stop 100% #00ffffff;
        }
        record { at 1s; duration 1s; }
      }
    }

    layer visual graphics {
      item badge {
        source generated shape {
          geometry ellipse { bounds 0% 0% 100% 100%; }
          fill solid #00ff00ff;
        }
        record { at 500ms; duration 1s; }
        modifiers {
          transform badge-motion {
            position curve {
              key enter { at 0s; value { x -8px; y 0px; } interpolation linear; }
              key settle { at 500ms; value { x 0px; y 0px; } interpolation linear; }
            }
            scale { x 0.35; y 0.35; }
          }
          composite badge-composite { opacity 85%; z-index 10; blend screen; }
          mask badge-mask {
            shape circle;
            position { x 50%; y 50%; }
            scale { x 45%; y 45%; }
            rotation 0deg;
            feather 1px;
            expansion 0px;
          }
        }
      }
    }

    layer audio sound {
      item silence { source generated silence; record { at 0s; duration 2s; } }
    }

    relation transition dissolve {
      endpoints { from item warm; to item cool; }
      timing { duration 400ms; alignment centered; }
      style { dissolve; }
    }
  }

  annotation marker ann-01-marker {
    target project; span untimed; payload { label "Agent marker"; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation language ann-02-language {
    target sequence main; span untimed; payload { candidate "en" { confidence 1; } }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation scene-boundary ann-03-boundary {
    target sequence main; span point { at 1s; } payload { confidence 1; hard-cut true; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation scene ann-04-scene {
    target sequence main; span range { at 0s; duration 2s; } payload {}
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation beat ann-05-beat {
    target sequence main; span point { at 1s; } payload { confidence 1; bar 1; beat-in-bar 1; tempo-bpm 120; meter 4; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation silence ann-06-silence {
    target sequence main; span range { at 1s; duration 200ms; } payload { mean-db -60db; confidence 1; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation filler ann-07-filler {
    target sequence main; span range { at 1.5s; duration 200ms; } payload { token "um"; confidence 1; suggestion tighten; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation highlight ann-08-highlight {
    target sequence main; span range { at 0s; duration 2s; } payload { score 1; rationale "Primary example"; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }
  annotation review ann-09-review {
    target sequence main; span range { at 0s; duration 2s; } payload { action keep; rationale "Approved"; confidence 1; }
    provenance { producer "veac-example"; request-sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; response-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"; }
  }

  output video main {
    sequence main;
    file-name "executable-mechanisms.mp4";
    encoding {
      container mp4; optimize-for-streaming true;
      video { codec h264; pixel-format yuv420p; }
      audio { codec aac; sample-rate 48000; channels 1; }
      captions discard;
    }
  }
}
