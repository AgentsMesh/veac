import "./annotations.veac" as annotations;
import "./showcase.veac" as showcase;

fn badge_style() -> VisualStyle {
  visual_style(
    visual_layout(
      placement_anchor(anchor_center(), vector(0.0, 0.0)), frame_none(),
      transform_2d(
        transform_motion(
          point_keyframes([
            point_keyframe(identifier("enter"), 0s, point(-533px, 0px), interpolation_linear()),
            point_keyframe(identifier("settle"), 500ms, point(0px, 0px), interpolation_ease_out())
          ]),
          vector_constant(vector(0.65, 0.65)), angle_constant(12deg)
        ),
        transform_geometry(
          vector(0.15, 0.0), flip_none(), vector(0.5, 0.5), crop_none()
        )
      )
    ),
    visual_surface(
      percent_constant(82%), compositing(3, blend_screen()),
      card_present(64px, shadow_present(24px, 45%, vector(20.0, 24.0), #07131dcc))
    ),
    [mask(
      mask_circle(),
      mask_motion(
        vector_constant(vector(0.5, 0.5)), vector_constant(vector(0.9, 0.9)),
        angle_constant(0deg)
      ),
      mask_edge(length_constant(20px), length_constant(0px)), false
    )],
    color_pipeline_none()
  )
}

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("example-font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let warm = item(
    identifier("warm"), item_enabled(), during(0s, 1200ms),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.5), vector(1.0, 0.5),
      [gradient_stop(0%, #ef4444ff), gradient_stop(100%, #facc15ff)]
    ))), source_timing_native()
  );
  let cool = item(
    identifier("cool"), item_enabled(), during(800ms, 1200ms),
    source_generated(generator_gradient(gradient_linear(
      vector(0.0, 0.5), vector(1.0, 0.5),
      [gradient_stop(0%, #2563ebff), gradient_stop(100%, #22d3eeff)]
    ))), source_timing_native()
  );
  let badge = item(
    identifier("badge"), item_enabled(), during(500ms, 1s),
    source_generated(vector_shape(
      geometry_ellipse(rect(0.0, 0.0, 1.0, 1.0)),
      paint_present(paint_solid(#34d399ff)),
      stroke_present(paint_solid(#ffffffff), 20px)
    )), source_timing_native()
  ).with_visual(badge_style());
  let scenes = visual_layer(
    identifier("scenes"), 0, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(warm).with_item(cool);
  let graphics = visual_layer(
    identifier("graphics"), 1, placement_free(),
    showcase.state(), track_routing_default()
  ).with_item(badge).with_item(item(
    identifier("label"), item_enabled(), during(0s, 2s),
    source_text(
      "可执行变换与叠加",
      showcase.caption_style(font, 48px, 600px)
    ), source_timing_native()
  ));
  let dissolve = relation_transition(
    identifier("centered"), warm, cool, transition_dissolve(400ms)
  );
  let timeline = sequence(
    identifier("main"), "可执行变换与叠加",
    sequence_settings(canvas(640px, 360px), frame_rate(30, 1), 48000)
  ).with_layer(scenes).with_layer(graphics).with_relation(dissolve);
  let output = showcase.video(
    timeline, canvas(640px, 360px), frame_rate(30, 1), false, false
  );
  let owner = project(identifier("executable-mechanisms"), project_settings(600))
    .with_resource(font).with_sequence(timeline).entry(timeline).with_delivery(output);
  annotations.attach(owner, timeline, graphics, badge)
}
