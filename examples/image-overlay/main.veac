project image-overlay {
  settings {
    timebase 1/1000;
    canvas 1280px by 720px;
    frame-rate 30fps;
    sample-rate 48000hz;
  }
  entry sequence main;

  resource image logo {
    locator local { path "assets/sample.png"; }
  }

  sequence main {
    layer visual base {
      item background {
        source generated solid { color #203040ff; }
        record { at 0s; duration 4s; }
      }
    }
    layer visual overlay {
      item logo {
        source media resource logo;
        record { at 0s; duration 4s; }
        modifiers {
          layout corner {
            placement anchor { at bottom-right; inset { x 48px; y 48px; } }
            frame { width 320px; height 320px; fit contain; }
          }
          transform scale { scale { x 0.35; y 0.35; } }
          composite blend { opacity 90%; z-index 20; blend screen; }
        }
      }
    }
  }
}
