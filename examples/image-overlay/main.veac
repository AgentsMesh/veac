import "./showcase.veac" as showcase;

fn logo_style() -> VisualStyle {
  visual_style(
    visual_layout(
      placement_anchor(anchor_bottom_right(), vector(48.0, 48.0)),
      frame_sized(320px, 320px, fit_contain()),
      transform_2d(
        transform_motion(
          point_constant(point(0px, 0px)), vector_constant(vector(0.75, 0.75)),
          angle_constant(0deg)
        ),
        transform_geometry(vector(0.0, 0.0), flip_none(), vector(1.0, 1.0), crop_none())
      )
    ),
    visual_surface(percent_constant(90%), compositing(20, blend_screen()), card_none()),
    [], color_pipeline_none()
  )
}

fn main(context: Context) -> Project {
  let logo = image_resource(
    identifier("logo"), resource_file("assets/logo.png"),
    sha256("39f18acad74ed5b4829f719a82d6342e3735a1119c54ac6b0a412dcdc4c57c02")
  );
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let base = visual_layer(
    identifier("base"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("background"), #203040ff, 0s, 4s));
  let overlay = visual_layer(
    identifier("overlay"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("logo"), item_enabled(), during(0s, 4s),
    source_media(logo), source_timing_native()
  ).with_visual(logo_style()));
  let labels = visual_layer(
    identifier("labels"), 2, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("explanation"), item_enabled(), during(0s, 4s),
    source_text(
      "图像叠加：右下锚定、等比缩放、透明度与滤色混合",
      showcase.caption_style(font, 34px, 880px)
    ), source_timing_native()
  ));
  let timeline = sequence(
    identifier("main"), "图片叠加",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(base).with_layer(overlay).with_layer(labels);
  let output = showcase.video(
    timeline, canvas(1280px, 720px), frame_rate(30, 1), false, false
  );
  project(identifier("image-overlay"), project_settings(600))
    .with_resource(logo).with_resource(font)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
