import "./outputs.veac" as outputs;
import "./showcase.veac" as showcase;

fn main(context: Context) -> Project {
  let font = font_resource(
    identifier("font"), resource_file("assets/veac-example-zh.ttf"),
    sha256("64afada094cf447d71fad4ee726799c4fa74917f7d9a1113ed7ea3c4234ff774")
  );
  let tone = audio_resource(
    identifier("delivery-tone"), resource_file("assets/delivery-tone.wav"),
    sha256("0829e8486d33569bfca7e5c9b781ffe2e2e13aafb1f5b7723dc230e61d93cf6d"),
    stream_auto()
  );
  let picture = visual_layer(
    identifier("picture"), 0, placement_free(), showcase.state(), track_routing_default()
  ).with_item(showcase.solid(identifier("opening"), #0d1b2aff, 0s, 1500ms))
    .with_item(showcase.solid(identifier("closing"), #c43a69ff, 1500ms, 1500ms));
  let audio = audio_layer(
    identifier("mix"), 1, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("reference-tone"), item_enabled(), during(0s, 3s),
    source_media(tone), source_timing_native()
  ));
  let caption_style = showcase.caption_style(font, 44px, 900px);
  let captions = caption_layer(
    identifier("subtitles"), 2, placement_free(), showcase.state(), track_routing_default()
  ).with_item(item(
    identifier("burned-label"), item_enabled(), during(0s, 1500ms),
    source_caption("类型化交付输出", caption_style), source_timing_native()
  )).with_item(item(
    identifier("traceable-label"), item_enabled(), during(1500ms, 1500ms),
    source_caption("可追踪的字幕伴随文件", caption_style), source_timing_native()
  ));
  let timeline = sequence(
    identifier("main"), "交付格式全集",
    sequence_settings(canvas(1280px, 720px), frame_rate(30, 1), 48000)
  ).with_layer(picture).with_layer(audio).with_layer(captions);
  let output = outputs.all(timeline, captions);
  project(identifier("delivery-formats"), project_settings(600))
    .with_resource(font).with_resource(tone)
    .with_sequence(timeline).entry(timeline).with_delivery(output)
}
